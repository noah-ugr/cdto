# Model settings for the steps that call a model. Copy to .env and fill in what you use.
# The benchmark runners read BENCHMARK_LLM_* first and fall back to LLM_*.
# The case-study driver ignores .env and reads the process environment only.

# anthropic | openai | openai_compatible
LLM_PROVIDER=
LLM_MODEL=
# /v1 URL of an OpenAI-compatible server (Ollama: http://localhost:11434/v1)
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_SEED=
LLM_TIMEOUT=600
# Optional: request format of an earlier run (2026-03-humaniser, 2026-04-28-benchmark)
LLM_REQUEST_PROFILE=

BENCHMARK_LLM_PROVIDER=
BENCHMARK_LLM_MODEL=
BENCHMARK_LLM_BASE_URL=
BENCHMARK_LLM_API_KEY=
BENCHMARK_LLM_TEMPERATURE=0
BENCHMARK_LLM_SEED=
BENCHMARK_LLM_TIMEOUT=600

# Provider keys, used when LLM_API_KEY is empty
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Input/output folder of the simulations. Leave it commented out for the default (/tmp/io);
# an empty value would make the simulations write in the current folder.
# CDTO_IO_DIR=
#
# On Windows, set PYTHONIOENCODING=utf-8 in the shell, not here: it must be set before Python starts.
